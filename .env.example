# Copy to .env.local (or set these in Hostinger's Node.js app settings). All optional.
# NEXT_PUBLIC_ values are read at build time, so rebuild after changing them.

# Contact form: the form ID from formspree.io (the part after /f/ in its endpoint). Unset = the form opens an email instead.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Analytics: the website ID from cloud.umami.is. Unset = no analytics script.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Media kit data source: "file" (content/media-kit.ts, the default) or "api" (a stub for now).
MEDIA_KIT_SOURCE=file
