# Copy to .env.local (or set these in Hostinger's Node.js app settings). All optional: anything left empty
# switches that feature off and the site still works. NEXT_PUBLIC_ values are read at build time, so
# redeploy after changing them. The others are read by the server and never reach the browser.

# Contact form: the form ID from formspree.io (the part after /f/ in its endpoint). Unset = the form opens an email instead.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Visitor and affiliate-click analytics. Plausible: the script link from its install snippet (https://plausible.io/js/pa-….js).
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Older Plausible accounts without a pa- link: the domain instead (byalyxx.com).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Or Umami Cloud: the website ID from cloud.umami.is.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Live media kit stats (see README: "Live media kit stats") ---
# Unlocks /media-kit/connect and the daily refresh. Any long random string, 16+ characters. Same value as the
# MEDIA_KIT_ADMIN_KEY secret in GitHub.
MEDIA_KIT_ADMIN_KEY=
# Supabase: Project Settings → API Keys. The URL looks like https://abcd.supabase.co; use a Secret key (sb_secret_…).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# YouTube: Google Cloud OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram: Meta app → Instagram → API setup with Instagram login (Instagram app ID and secret).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok: developers.tiktok.com app (Sandbox is fine) → Client key and Client secret.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Only while the site runs on another address (e.g. Hostinger's temporary domain): that address.
SITE_URL=
# "file" (content/media-kit.ts only) or "live" (Supabase on top of the file). Unset = live once Supabase is set up.
MEDIA_KIT_SOURCE=
